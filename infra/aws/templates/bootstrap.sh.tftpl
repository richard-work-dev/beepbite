#!/usr/bin/env bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

install -d -m 0750 -o root -g docker /opt/beepbite
install -d -m 0750 -o root -g docker /opt/beepbite/config
install -d -m 0750 -o root -g docker /opt/beepbite/data
install -d -m 0750 -o root -g docker /opt/beepbite/backups

cat >/opt/beepbite/config/infrastructure.env <<'EOF'
AWS_REGION=${aws_region}
ECR_REPOSITORY=${ecr_repository}
UPLOADS_BUCKET=${uploads_bucket}
BACKUPS_BUCKET=${backups_bucket}
RUNTIME_SECRET_ID=${runtime_secret}
UPLOADS_PUBLIC_BASE_URL=${uploads_base_url}
EOF

chmod 0640 /opt/beepbite/config/infrastructure.env

# The application is deployed separately after the runtime secret is populated.
# No credential or application secret is stored in EC2 user data.
